      "execute((address recipient, address buyToken, uint256 minAmountOut) slippage, bytes[] actions, bytes32 zid)": {
        "intent": "Swap",
        "fields": [
          { "path": "@.value", "label": "ETH sent", "format": "amount", "visible": { "ifNotIn": ["0"] } },
          {
            "path": "slippage.minAmountOut",
            "label": "Receive at least",
            "format": "tokenAmount",
            "params": { "tokenPath": "slippage.buyToken", "nativeCurrencyAddress": ["0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE"] },
            "visible": "always"
          },
          {
            "path": "slippage.recipient",
            "label": "Receiver",
            "format": "addressName",
            "params": { "types": ["eoa", "wallet", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          { "path": "actions.[]", "label": "Route", "format": "raw", "visible": "never" },
          { "path": "zid", "label": "Tag", "format": "raw", "visible": "never" }
        ]
      }
    }
  }
