            }
          },
          {
            "path": "oldAmountPerSec",
            "label": "Was rate",
            "format": "unit",
            "params": {
              "base": " USDC a second",
              "decimals": 20
            }
          },
          {
            "path": "to",
            "label": "Now to",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ],
              "sources": [
                "local",
                "ens"
              ]
            }
          },
          {
            "path": "amountPerSec",
            "label": "Now rate",
            "format": "unit",
            "params": {
              "base": " USDC a second",
