      "pauseStream(address to,uint216 amountPerSec)": {
        "intent": "Pause a stream",
        "fields": [
          {
            "path": "to",
            "label": "To",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ],
              "sources": [
                "local",
                "ens"
              ]
            }
          },
          {
            "path": "amountPerSec",
            "label": "Rate",
            "format": "unit",
            "params": {
              "base": " USDC a second",
